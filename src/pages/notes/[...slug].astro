---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

// The sidebar tree: every note, grouped by folder, the current one marked.
const all = await getCollection('notes');
const folderOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '');
const FOLDER_ORDER = ['', 'plan', 'playbooks', 'learning', 'setup'];
const folders = [...new Set(all.map((n) => folderOf(n.id)))].sort(
  (a, b) => (FOLDER_ORDER.indexOf(a) + 99 * +(FOLDER_ORDER.indexOf(a) < 0)) - (FOLDER_ORDER.indexOf(b) + 99 * +(FOLDER_ORDER.indexOf(b) < 0)),
);
const inFolder = (f: string) =>
  all.filter((n) => folderOf(n.id) === f).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const filePath = entry.filePath ?? `src/content/notes/${entry.id}.md`;
const editUrl = SITE.repoUrl ? `${SITE.repoUrl.replace(/\/$/, '')}/edit/${SITE.branch}/${filePath}` : '';
---

<Base title={entry.data.title} description={entry.data.description} wide>
  <div class="doc">
    <aside class="toc">
      <details id="tree">
        <summary>The vault</summary>
        {folders.map((f) => (
          <div class="treegroup">
            {f && <p class="treehead">{f}</p>}
            <ol>
              {inFolder(f).map((n) => (
                <li>
                  <a href={`/notes/${n.id}/`} class:list={[{ here: n.id === entry.id }]}>{n.data.title}</a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </details>
      {toc.length > 2 && (
        <details id="toc" style="margin-top:10px">
          <summary>On this page</summary>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      )}
    </aside>

    <article class="prose">
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="lead">{entry.data.description}</p>}
      <Content />
      {editUrl && (
        <p class="edit">
          <a href={editUrl}>Edit this page on GitHub</a> · or edit the file locally and push; live in about a minute.
        </p>
      )}
    </article>
  </div>
</Base>

<script>
  // Open the sidebar by default on wide screens; keep it collapsed on phones.
  for (const id of ['tree', 'toc']) {
    const el = document.getElementById(id) as HTMLDetailsElement | null;
    if (el && window.matchMedia('(min-width: 960px)').matches) el.open = true;
  }

  // "Copy" buttons on scripts (blockquotes) and prompts (pre).
  document.querySelectorAll<HTMLElement>('.prose pre, .prose blockquote').forEach((el) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      const text =
        el.tagName === 'PRE'
          ? (el.querySelector('code') || el).innerText
          : Array.from(el.children)
              .filter((c) => c !== btn)
              .map((c) => (c as HTMLElement).innerText)
              .join('\n\n');
      try {
        await navigator.clipboard.writeText(text.trim());
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
    el.classList.add('has-copy');
    el.prepend(btn);
  });
</script>
